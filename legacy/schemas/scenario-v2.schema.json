          "maximum": 0.17453292519943295,
          "title": "Maximum Angle Of Attack Rad",
          "type": "number"
        },
        "diagnostic_continuation": {
          "default": false,
          "title": "Diagnostic Continuation",
          "type": "boolean"
        }
      },
      "title": "AerodynamicLimits",
      "type": "object"
    },
    "Atmosphere": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "isa1976",
