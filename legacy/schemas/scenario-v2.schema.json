          "enum": [
            "isa1976"
          ],
          "title": "Model",
          "type": "string"
        },
        "wind_world_mps": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Wind World Mps",
          "type": "array"
        }
      },
      "title": "Atmosphere",
      "type": "object"
    },
    "FinCommand": {
      "additionalProperties": false,
      "properties": {
        "time_s": {
          "minimum": 0.0,
          "title": "Time S",
          "type": "number"
        },
        "fin_set_id": {
          "pattern": "^[a-z][a-z0-9_\\-]*$",
          "title": "Fin Set Id",
          "type": "string"
        },
        "deflection_rad": {
          "title": "Deflection Rad",
          "type": "number"
        }
      },
      "required": [
        "time_s",
        "fin_set_id",
        "deflection_rad"
      ],
      "title": "FinCommand",
      "type": "object"
    },
    "IntegrationSettings": {
      "additionalProperties": false,
      "properties": {
