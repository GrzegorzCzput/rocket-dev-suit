          "default": 1.5707963267948966,
          "maximum": 1.5707963267948966,
          "minimum": 0.0,
          "title": "Inclination Rad",
          "type": "number"
        },
        "heading_rad": {
          "default": 0.0,
          "maximum": 3.141592653589793,
          "minimum": -3.141592653589793,
          "title": "Heading Rad",
          "type": "number"
        }
      },
      "required": [
        "length_m"
      ],
      "title": "LaunchRail",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "atmosphere": {
          "$ref": "#/$defs/Atmosphere"
        },
        "launch_rail": {
