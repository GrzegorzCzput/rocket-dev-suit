          "maximum": 0.02,
          "title": "Time Step S",
          "type": "number"
        },
        "controller_rate_hz": {
          "default": 100.0,
          "exclusiveMinimum": 0.0,
          "title": "Controller Rate Hz",
          "type": "number"
        }
      },
      "title": "IntegrationSettings",
      "type": "object"
    },
    "LaunchRail": {
      "additionalProperties": false,
      "properties": {
