{
  "$defs": {
    "Actuation": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "fixed",
            "all_moving",
            "control_surface"
          ],
          "title": "Type",
          "type": "string"
        },
        "span_start_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Start Fraction"
        },
        "hinge_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hinge Fraction"
        },
        "minimum_deflection_rad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Deflection Rad"
        },
        "maximum_deflection_rad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Deflection Rad"
        }
      },
      "required": [
        "type"
      ],
      "title": "Actuation",
      "type": "object"
    },
    "Body": {
      "additionalProperties": false,
      "properties": {
        "length_m": {
          "exclusiveMinimum": 0.0,
          "title": "Length M",
          "type": "number"
        },
        "diameter_m": {
          "exclusiveMinimum": 0.0,
          "title": "Diameter M",
          "type": "number"
        },
        "aerodynamics": {
          "$ref": "#/$defs/ComponentAerodynamics"
        }
      },
      "required": [
        "length_m",
        "diameter_m"
      ],
      "title": "Body",
      "type": "object"
    },
    "ComponentAerodynamics": {
      "additionalProperties": false,
      "properties": {
        "skin_friction_coefficient": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Skin Friction Coefficient",
          "type": "number"
        },
        "pressure_drag_coefficient": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Pressure Drag Coefficient",
          "type": "number"
        }
      },
      "title": "ComponentAerodynamics",
      "type": "object"
    },
    "FinGeometry": {
      "additionalProperties": false,
      "properties": {
        "root_chord_m": {
          "exclusiveMinimum": 0.0,
          "title": "Root Chord M",
          "type": "number"
        },
        "tip_chord_m": {
          "exclusiveMinimum": 0.0,
          "title": "Tip Chord M",
          "type": "number"
        },
        "span_m": {
          "exclusiveMinimum": 0.0,
          "title": "Span M",
          "type": "number"
        },
        "sweep_m": {
          "minimum": 0.0,
          "title": "Sweep M",
          "type": "number"
        },
        "thickness_m": {
          "exclusiveMinimum": 0.0,
          "title": "Thickness M",
          "type": "number"
        }
      },
      "required": [
        "root_chord_m",
        "tip_chord_m",
        "span_m",
        "sweep_m",
        "thickness_m"
      ],
      "title": "FinGeometry",
      "type": "object"
    },
    "FinSet": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "station_m": {
          "minimum": 0.0,
          "title": "Station M",
          "type": "number"
        },
        "count": {
          "enum": [
            3,
            4,
            6
          ],
          "title": "Count",
          "type": "integer"
        },
        "angular_offset_rad": {
          "exclusiveMaximum": 6.283185307179586,
          "minimum": 0.0,
          "title": "Angular Offset Rad",
          "type": "number"
        },
        "geometry": {
          "$ref": "#/$defs/FinGeometry"
        },
        "actuation": {
          "$ref": "#/$defs/Actuation"
        },
        "aerodynamics": {
          "$ref": "#/$defs/ComponentAerodynamics"
        },
        "control_effectiveness": {
          "default": 0.7,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Control Effectiveness",
          "type": "number"
        }
      },
      "required": [
        "id",
        "station_m",
        "count",
        "angular_offset_rad",
        "geometry",
        "actuation"
      ],
      "title": "FinSet",
      "type": "object"
    },
    "MassProperties": {
      "additionalProperties": false,
      "properties": {
        "mass_kg": {
          "exclusiveMinimum": 0.0,
          "title": "Mass Kg",
          "type": "number"
        },
        "center_of_mass_station_m": {
          "minimum": 0.0,
          "title": "Center Of Mass Station M",
          "type": "number"
        },
        "inertia_xx_kg_m2": {
          "exclusiveMinimum": 0.0,
          "title": "Inertia Xx Kg M2",
          "type": "number"
        },
        "inertia_yy_kg_m2": {
          "exclusiveMinimum": 0.0,
          "title": "Inertia Yy Kg M2",
          "type": "number"
        },
        "inertia_zz_kg_m2": {
          "exclusiveMinimum": 0.0,
          "title": "Inertia Zz Kg M2",
          "type": "number"
        }
      },
      "required": [
        "mass_kg",
        "center_of_mass_station_m",
        "inertia_xx_kg_m2",
        "inertia_yy_kg_m2",
        "inertia_zz_kg_m2"
      ],
      "title": "MassProperties",
      "type": "object"
    },
    "Nose": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "half_ellipsoid",
          "enum": [
            "half_ellipsoid"
          ],
          "title": "Type",
          "type": "string"
        },
        "length_m": {
          "exclusiveMinimum": 0.0,
          "title": "Length M",
          "type": "number"
        },
        "aerodynamics": {
          "$ref": "#/$defs/ComponentAerodynamics"
        }
      },
      "required": [
        "type",
        "length_m"
      ],
      "title": "Nose",
      "type": "object"
    },
    "Rocket": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/Body"
        },
        "nose": {
          "$ref": "#/$defs/Nose"
        },
        "mass_properties": {
          "$ref": "#/$defs/MassProperties"
        },
        "fin_sets": {
          "items": {
            "$ref": "#/$defs/FinSet"
          },
          "title": "Fin Sets",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "body",
        "nose",
        "mass_properties"
      ],
      "title": "Rocket",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "enum": [
        1
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "rocket": {
      "$ref": "#/$defs/Rocket"
    }
  },
  "required": [
    "schema_version",
    "rocket"
  ],
  "title": "RocketDefinition",
  "type": "object"
}
